# UCKhabar Backend — Environment Variables
# Copy this file to .env and fill in your values before running locally.
# On Cloud Run, set these as Secret Manager secrets or environment variables.

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_google_ai_api_key_here
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# ── Google Cloud ─────────────────────────────────────────────────────────────
GCP_PROJECT_ID=your_gcp_project_id_here

# Path to your Firebase service account JSON (local dev only).
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# On Cloud Run this is NOT needed — the instance's default service account is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8080

# ── Feed tuning (optional — defaults shown) ───────────────────────────────────
# MAX_ARTICLES_PER_FEED=15
# RSS_POLL_INTERVAL_MINUTES=30
# SCORING_INTERVAL_MINUTES=120
# ARTICLE_RETENTION_HOURS=24
# MAX_ARTICLES_PER_GEMINI_CALL=40
